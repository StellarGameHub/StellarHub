{
  "name": "stellarhub",
  "version": "0.2.0",
  "description": "Lanzador de juegos para Linux",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "watch:main": "tsc -p tsconfig.main.json --watch",
    "watch:renderer": "vite",
    "dev": "concurrently \"npm run watch:main\" \"npm run watch:renderer\" --kill-others --success first",
    "start": "cross-env NODE_ENV=development electron .",
    "watch": "concurrently \"npm run watch:main\" \"npm run watch:renderer\" \"wait-on dist/main/main.js && cross-env NODE_ENV=development electron .\"",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.stellarhub.app",
    "productName": "StellarHub",  
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/openid-client": "^3.1.6",
    "@types/sparql-http-client": "^3.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "typescript": "^6.0.0",
    "vite": "^6.0.0",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vite-plugin-node-polyfills": "^0.27.0",
    "wait-on": "^8.0.0"
  },
  "keywords": [
    "games",
    "launcher",
    "linux",
    "proton"
  ],
  "author": {
    "name": "Joel Delgado",
    "email": "joeldelgadogopar2@gmail.com"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "cheerio": "^1.2.0",
    "electron-log": "^5.4.3",
    "openid-client": "^4.9.1",
    "sparql-http-client": "^3.1.0",
    "steamgriddb": "^2.2.1"
  }
}